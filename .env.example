# ---------------------------------------------------------------------------
# Digital Stage configuration. Copy to .env.local and fill in what you have.
# Leave everything blank to run in DEMO MODE (no AWS, no Supabase).
# Never commit .env.local.
# ---------------------------------------------------------------------------

# Slug of the venue this deployment serves by default (matches venues.slug).
NEXT_PUBLIC_DEFAULT_VENUE_SLUG=onyx

# Force demo mode even when credentials are present: demo | auto
DIGITAL_STAGE_MODE=auto

# ---- AWS IVS (server only; never prefixed with NEXT_PUBLIC_) ----------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set to "true" to use the default credential chain (IAM role) instead of keys.
AWS_USE_DEFAULT_CREDENTIAL_CHAIN=

# Fallback channel for the default venue when the venues table has none.
AWS_IVS_CHANNEL_ARN=
AWS_IVS_PLAYBACK_URL=

# Official IVS Player SDK version loaded from player.live-video.net
NEXT_PUBLIC_IVS_PLAYER_VERSION=1.25.0

# ---- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for the seed script and operator tooling, never by pages.
SUPABASE_SERVICE_ROLE_KEY=
